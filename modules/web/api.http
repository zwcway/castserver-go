@baseUrl = http://localhost:4415
@wsUrl = ws://localhost:4415/api

# ============================================
# 设备列表 (Speaker)
# ============================================

### 获取设备列表
POST {{baseUrl}}/api/speakerList
Content-Type: application/json

{}

### 获取设备明细
POST {{baseUrl}}/api/speakerInfo
Content-Type: application/json

1
### 设置设备
POST {{baseUrl}}/api/setSpeaker
Content-Type: application/json

{
    "id": 1,
    "name": "主音箱",
    "line": 1,
    "ch": 1,
    "vol": 80,
    "mute": false
}

### 设置设备音量
POST {{baseUrl}}/api/speakerVolume
Content-Type: application/json

{
    "id": 1,
    "vol": 80,
    "mute": false
}

# ============================================
# 线路 (Line)
# ============================================

### 获取线路列表
POST {{baseUrl}}/api/lineList
Content-Type: application/json


### 获取线路明细
POST {{baseUrl}}/api/lineInfo
Content-Type: application/json

{
    "id": 1
}
### 创建线路
POST {{baseUrl}}/api/createLine
Content-Type: application/json

{
    "name": "新线路"
}

### 编辑线路
POST {{baseUrl}}/api/setLine
Content-Type: application/json

{
    "id": 1,
    "name": "线路新名称",
    "sl": true
}


### 删除线路
POST {{baseUrl}}/api/deleteLine
Content-Type: application/json

{
    "id": 1,
    "moveTo": 0
}


### 设置线路音量
POST {{baseUrl}}/api/lineVolume
Content-Type: application/json

{
    "id": 1,
    "vol": 80,
    "mute": false
}


### 获取线路 Pipeline 信息
POST {{baseUrl}}/api/linePipeLine
Content-Type: application/json

{
    "id": 1
}


# ============================================
# 均衡器 (Equalizer)
# ============================================

### 设置线路均衡器
POST {{baseUrl}}/api/setLineEQ
Content-Type: application/json

{
    "id": 1,
    "seg": 1,
    "freq": 1000,
    "gain": 3.0
}

### 清除线路均衡器
POST {{baseUrl}}/api/clearLineEQ
Content-Type: application/json

{
    "id": 1,
    "seg": 10
}

### 启用/禁用线路均衡器
POST {{baseUrl}}/api/enableLineEQ
Content-Type: application/json

{
    "id": 1,
    "enable": true
}

# ============================================
# 播放器 (Player)
# ============================================

### 获取线路播放器状态
POST {{baseUrl}}/api/linePlayer
Content-Type: application/json

{
    "id": 1
}

### 播放器跳转
POST {{baseUrl}}/api/lineSeek
Content-Type: application/json

{
    "id": 1,
    "pos": 30
}

# ============================================
# 测试声音
# ============================================

### 测试声音
POST {{baseUrl}}/api/soundTest
Content-Type: application/json

{
    "line": 1,
    "ch": 1
}

# ============================================
# 状态与订阅
# ============================================

### 获取状态
POST {{baseUrl}}/api/status
Content-Type: application/json

{
    "sct": "config"
}

### 订阅事件
POST {{baseUrl}}/api/subscribe
Content-Type: application/json

{
    "act": true,
    "evt": [1, 2],
    "sub": 0,
    "arg": 0
}

### 取消订阅
POST {{baseUrl}}/api/subscribe
Content-Type: application/json

{
    "act": false,
    "evt": [1, 2]
}

# ============================================
# Debug 接口 (仅 debug 构建)
# ============================================

### 添加扬声器
POST {{baseUrl}}/api/addSpeaker
Content-Type: application/json

{
    "v": 3,
    "id": 1,
    "ip": "192.168.1.100",
    "mac": "AA:BB:CC:DD:EE:FF",
    "port": 5000,
    "bits": ["16", "24", "32"],
    "rate": [44100, 48000],
    "avol": false
}

### 扬声器重连
POST {{baseUrl}}/api/spReconnect
Content-Type: application/json

1

### 发送采样格式
POST {{baseUrl}}/api/spSample
Content-Type: application/json

1

### 发送服务器信息
POST {{baseUrl}}/api/sendServerInfo
Content-Type: application/json

1

### 模拟事件广播
POST {{baseUrl}}/api/eventDebug
Content-Type: application/json

1

### 本地播放器开关
POST {{baseUrl}}/api/localSpeaker
Content-Type: application/json

true

### 播放音频文件
POST {{baseUrl}}/api/playFile
Content-Type: application/json

{
    "Line": 1,
    "File": "/mnt/r/1.wav"
}

### 暂停播放
POST {{baseUrl}}/api/pause
Content-Type: application/json

{
    "Line": 1,
    "Pause": false
}

### Debug 状态
POST {{baseUrl}}/api/debugStatus
Content-Type: application/json

{
    "line": 1
}

### 管道元开关
POST {{baseUrl}}/api/elementPower
Content-Type: application/json

{
    "line": 1,
    "n": "element_name",
    "on": true
}